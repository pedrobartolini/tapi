{
  "name": "tapi-rs",
  "version": "8.0.1",
  "description": "A modern, type-safe REST API client builder for TypeScript/JavaScript applications with React hooks integration and intelligent error handling.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "check-format": "prettier --check \"src/**/*.ts\"",
    "verify": "node verify-build.js",
    "pack-test": "npm pack --dry-run"
  },
  "keywords": [
    "typescript",
    "api",
    "client",
    "rest",
    "react",
    "hooks",
    "type-safe",
    "fetch"
  ],
  "author": "Pedro Bartolini",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrobartolini/tapi.git"
  },
  "bugs": {
    "url": "https://github.com/pedrobartolini/tapi/issues"
  },
  "homepage": "https://github.com/pedrobartolini/tapi#readme",
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0",
    "react": "^19.1.0",
    "@types/react": "^18.2.0"
  }
}
